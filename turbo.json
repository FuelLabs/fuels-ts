{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": ["internal/fuel-core/VERSION"],
  "tasks": {
    "type:check": {
      "outputLogs": "errors-only"
    },
    "preinstall": {
      "outputLogs": "new-only"
    },
    "prebuild": {
      "dependsOn": ["^prebuild", "preinstall"],
      "outputLogs": "new-only"
    },
    "build": {
      "dependsOn": ["^build", "prebuild"],
      "outputs": ["dist/**"],
      "outputLogs": "new-only"
    },
    "postbuild": {
      "dependsOn": ["^postbuild", "build"],
      "outputLogs": "new-only"
    },
    "pretest": {
      "outputLogs": "errors-only",
      "inputs": [
        "**/test/fixtures/forc-projects/Forc.toml",
        "**/test/fixtures/forc-projects/**/src/*.sw",
        "**/test/fixtures/forc-projects/**/Forc.toml",
        "scripts/generate-state-transition-bytecode.ts"
      ],
      "outputs": [
        "**/test/fixtures/forc-projects/**/out/release/**",
        "**/test/fixtures/chain-config/*.generated.ts"
      ]
    },
    "test": {
      "dependsOn": ["^test", "pretest"],
      "outputLogs": "new-only"
    },
    "test:forc": {
      "dependsOn": ["^test:forc", "build"],
      "outputLogs": "new-only"
    }
  }
}
